{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Croatian service route directory",
  "type": "object",
  "required": ["schemaVersion", "lastInventoryUpdate", "services"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "lastInventoryUpdate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "disclaimerHr": { "type": "string" },
    "disclaimerEn": { "type": "string" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "serviceName",
          "city",
          "address",
          "serviceTypes",
          "phone",
          "email",
          "website",
          "workingHours",
          "appointmentRequired",
          "anonymous",
          "free",
          "sourceUrl",
          "sourceName",
          "dateLastVerified",
          "status",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "serviceName": { "type": "string", "minLength": 1 },
          "city": { "type": "string", "minLength": 1 },
          "address": { "type": "string", "minLength": 1 },
          "serviceTypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["HIV testing", "counseling", "PEP", "PrEP", "emergency", "psychosocial support", "STI testing", "hepatitis testing", "other"]
            }
          },
          "phone": { "type": "string", "minLength": 1 },
          "email": { "type": "string", "minLength": 1 },
          "website": { "type": "string", "pattern": "^https?://|^unknown$" },
          "workingHours": { "type": "string", "minLength": 1 },
          "appointmentRequired": { "type": "string", "enum": ["yes", "no", "unknown"] },
          "anonymous": { "type": "string", "enum": ["yes", "no", "unknown"] },
          "free": { "type": "string", "enum": ["yes", "no", "unknown"] },
          "sourceUrl": { "type": "string", "pattern": "^https?://" },
          "sourceName": { "type": "string", "minLength": 1 },
          "dateLastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "status": { "type": "string", "enum": ["verified", "needs-verification", "temporarily-unavailable", "unknown"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
