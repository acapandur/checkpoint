{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Map Without Stigma health claims inventory",
  "type": "object",
  "required": ["schemaVersion", "lastInventoryUpdate", "claims"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "lastInventoryUpdate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "reviewPolicy": { "type": "string" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "pageOrComponent",
          "claimHr",
          "category",
          "sourceUrl",
          "sourceName",
          "dateLastVerified",
          "nextReviewDate",
          "owner",
          "medicalReviewStatus",
          "notes",
          "verificationStatus",
          "source",
          "verifiedAt",
          "expiresAt"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "pageOrComponent": { "type": "string", "minLength": 1 },
          "claimHr": { "type": "string", "minLength": 1 },
          "claimEn": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["PEP", "PrEP", "HIV testing", "emergency", "privacy", "service route", "stigma", "other"]
          },
          "sourceUrl": { "type": "string", "minLength": 1 },
          "sourceName": { "type": "string", "minLength": 1 },
          "dateLastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "nextReviewDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "owner": { "type": "string", "minLength": 1 },
          "medicalReviewStatus": { "type": "string", "enum": ["unreviewed", "needs-review", "reviewed"] },
          "notes": { "type": "string" },
          "verificationStatus": { "type": "string", "enum": ["verified", "needs-verification", "unverified"] },
          "source": { "type": "string", "minLength": 1 },
          "verifiedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "expiresAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
