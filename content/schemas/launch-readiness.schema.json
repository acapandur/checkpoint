{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Launch readiness checklist",
  "type": "object",
  "required": ["schemaVersion", "lastProjectReview", "status", "items"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "lastProjectReview": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "type": "string", "enum": ["prototype", "internal-review", "public-ready"] },
    "summaryHr": { "type": "string" },
    "summaryEn": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "labelHr", "labelEn", "status", "owner", "notesHr", "notesEn"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "labelHr": { "type": "string", "minLength": 1 },
          "labelEn": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["not started", "in progress", "blocked", "complete"] },
          "owner": { "type": "string", "minLength": 1 },
          "notesHr": { "type": "string" },
          "notesEn": { "type": "string" }
        }
      }
    }
  }
}
